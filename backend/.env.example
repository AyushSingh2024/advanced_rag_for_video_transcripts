QDRANT_API_KEY=
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
QDRANT_COLLECTION=lecture_chunks
CHAT_MODEL=gpt-4o-mini
GENERATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
